# Env for e2e runs (`vite --mode test`). All values are fake: every network call
# is intercepted by Playwright's page.route(), nothing here reaches a real service.
VITE_API_URL=http://localhost:8080
VITE_LIVEKIT_URL=wss://livekit.test
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:8080/token
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test
