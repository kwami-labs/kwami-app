# Env for e2e runs (`vite --mode test`). All values are fake: every network call
# is intercepted by Playwright's page.route(), nothing here reaches a real service.
#
# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY are the two vars src/lib/env.ts
# treats as REQUIRED — omitting either makes AuthGuard render the config-error
# screen instead of the app, which would fail every spec.
VITE_API_URL=http://localhost:8080
VITE_LIVEKIT_URL=wss://livekit.test
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test

# Pinned so the login surface is deterministic: the app default is `google`
# alone, and specs that count provider buttons depend on this being explicit.
VITE_AUTH_PROVIDERS=google
