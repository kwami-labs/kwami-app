# =============================================================================
# Kwami App - Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in your credentials:
#   cp .env.sample .env
#
# =============================================================================

# API
VITE_API_URL=http://localhost:8080

# LiveKit
VITE_LIVEKIT_URL=wss://your-server.livekit.cloud

# Supabase Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sign-in providers to offer, comma-separated. Only list providers you have
# actually enabled in the Supabase dashboard — an unconfigured provider
# returns 400, so showing its button is worse than hiding it.
# Supported: google, apple, azure (Microsoft), github, phantom, metamask
#
# Email + password is always available and is NOT listed here; it needs the
# Email provider enabled in Supabase (Authentication -> Providers).
# `phantom` needs Authentication -> Web3 (Solana) enabled;
# `metamask` needs Authentication -> Web3 (Ethereum) enabled.
VITE_AUTH_PROVIDERS=google,phantom,metamask
