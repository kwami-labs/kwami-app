#!/usr/bin/env sh
#
# Rejects a commit that would introduce unformatted source.
# Bypass with `git commit --no-verify`.
set -eu

staged="$(git diff --cached --name-only --diff-filter=d -z | tr '\0' '\n' | grep -E '\.(ts|vue|css|js|mjs)$' || true)"

[ -n "$staged" ] || exit 0

if ! printf '%s\n' "$staged" | xargs bunx prettier --check; then
	cat >&2 <<EOF

  Staged files are not Prettier-clean. Fix them with:

    bun run format

  then stage the result.

EOF
	exit 1
fi
