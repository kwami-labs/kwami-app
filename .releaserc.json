{
  "tagFormat": "v${version}",
  "branches": [
    "main",
    { "name": "stg", "prerelease": "stg" }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "breaking": true, "release": "minor" },
          { "type": "*", "release": "patch" }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "angular" }],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# kwami-app — Changelog\n\nAll notable changes to this client are documented here. This file is generated from the commit history by semantic-release — do not edit it by hand.\n\n`v0.1.0` is a baseline tag placed at the commit that introduced this automation. Everything before it lives in the git log rather than here: it shipped before there was a release line to put it on."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i -E 's|badge/release-v[0-9.]+(-[A-Za-z0-9.]+)?|badge/release-v${nextRelease.version}|' README.md"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "README.md"],
        "message": "chore(release): v${nextRelease.version} [skip actions]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "releasedLabels": false,
        "failTitle": "The automated release is failing 🚨"
      }
    ]
  ]
}
